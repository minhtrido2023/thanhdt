[Unit]
Description=Mike Work-Tree Dashboard (stdlib HTTP, cổng 8610)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/trido/thanhdt/WorkingClaude/mike
Environment=PATH=/home/trido/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=WT_PORT=8610
ExecStart=/usr/bin/python3 /home/trido/thanhdt/WorkingClaude/mike/bin/work_tree_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
