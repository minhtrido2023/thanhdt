> def _price_tokens(text):
>     """Danh sách (giá_đ, vị_trí_cuối) cho các số KHÔNG kèm % ở đầu text."""
>     out = []
>     for m in _VAL.finditer(text):
>         if text[m.end():m.end() + 2].lstrip().startswith("%"):
>             continue
>         out.append((_to_vnd(m.group(1), m.group(2)), m.start(), m.end(), bool(m.group(2))))
>     return out
> 
