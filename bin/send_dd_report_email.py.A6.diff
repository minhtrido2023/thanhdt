> def _to_vnd(tok, unit):
>     """'59,8'+k → 59800; '9.950' → 9950; '59'+nghìn → 59000."""
>     v = float(tok.replace(".", "").replace(",", ".")) if re.fullmatch(r"\d{1,3}(?:\.\d{3})+", tok) else float(tok.replace(",", "."))
>     return v * 1000 if unit else v
