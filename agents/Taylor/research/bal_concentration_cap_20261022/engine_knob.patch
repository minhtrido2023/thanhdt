@@ -2122,6 +2122,22 @@ BAL_KW = dict(allowed_tiers=RS["allowed_tiers"], max_positions=MAX_POS_V11,
               open_prices=open_prices, t1_open_exec=True,
               entry_alt_prices=None,           # AUDIT: BQ-verifiable T+1 Open fills only
               force_close_eod=False, **ETF_LIQ_KW)
+# R&D bal_concentration_cap_20261022 (READ-ONLY job Taylor_20261022_095008): cap each new BAL stock position at
+# BAL_WMAX_NAV of COMBINED NAV, mapped to book terms via s(t-1)=cap_bal/combined_nav of the control ledger
+# BAL_WMAX_SREF (2-pass approximation, PREREG). Unset = byte-identical.
+BAL_WMAX_NAV = float(os.environ.get("BAL_WMAX_NAV", "0") or 0)
+if BAL_WMAX_NAV > 0:
+    import gzip as _gz
+    _sref = pd.read_csv(_gz.open(os.environ["BAL_WMAX_SREF"]), low_memory=False)
+    _sref = _sref[_sref.record_type == "DAILY"]
+    _s = (_sref.cap_bal.astype(float) / _sref.combined_nav.astype(float)).values
+    _dts = pd.to_datetime(_sref.ymd).values
+    _capmap = {pd.Timestamp(_dts[i]): BAL_WMAX_NAV / _s[i - 1] for i in range(1, len(_dts))}
+    _capmap[pd.Timestamp(_dts[0])] = BAL_WMAX_NAV / _s[0]
+    BAL_KW["pos_cap_frac_by_date"] = _capmap
+    BAL_KW["pos_cap_tiers"] = set(TIER_BAL) | {t + "_W" for t in TIER_BAL}
+    assert EXP_TAG, "BAL_WMAX_NAV requires EXP_TAG (non-canonical output name, §8)"
+    print(f"  [BAL_WMAX_NAV] cap {BAL_WMAX_NAV:.3f} of combined NAV; book-frac median {np.median(list(_capmap.values())):.4f}")
 if capit_events:
     nav_bal0, _ = simulate(sig_f, prices, vni_dates, tier_weights=RS["tier_weights"],
                            name="v23audit_BAL_base", **BAL_KW, **LIQ_FULL)
