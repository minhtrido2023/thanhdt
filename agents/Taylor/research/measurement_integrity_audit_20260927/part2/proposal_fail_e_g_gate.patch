+    "bootstrap_nav.py", "dsr_pbo_annex.py", "regime_size_overlay.py",
+]
+_QTY = r"(?:Volume[A-Za-z0-9_]*|OShares)"
+_ADJ = r"(?:Close(?:_T1W?)?)"
+_PFX = r"(?:[A-Za-z_][A-Za-z0-9_]*\.)?"
