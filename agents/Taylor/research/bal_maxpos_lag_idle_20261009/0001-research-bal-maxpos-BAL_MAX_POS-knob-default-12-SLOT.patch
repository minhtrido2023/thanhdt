+# --- RESEARCH-ONLY instrumentation (job Taylor_20261008_163222, branch research/bal-maxpos-lag-idle-20261009) ---
+# SLOT_AUDIT_LOG=<csv> logs every first-fill decision of the named books: SLOT_BLOCK (rejected because
+# completed positions >= max_positions), CASH_SKIP (affordable size < 1M VND), FILL_START (sized+started).
+# Pure logging: no state is read-modified; unset => byte-identical (proved by the inertness leg).
+import atexit as _atexit
+_SLOT_AUDIT_PATH = os.environ.get("SLOT_AUDIT_LOG", "")
+_SLOT_AUDIT_BOOKS = set(os.environ.get("SLOT_AUDIT_BOOKS", "v23audit_BAL").split(","))
+_SLOT_AUDIT = []
+def _slot_audit_rec(today, name, entry, outcome, n_slots, cash, cur_nav, state_by_date, target=None):
+    _st = state_by_date.get(today) if state_by_date else None
+    _SLOT_AUDIT.append({"ymd": today, "book": name, "ticker": entry["ticker"], "play_type": entry["play_type"],
+                        "ta": entry.get("ta"), "seq_id": entry.get("seq_id"), "exec_start": entry.get("exec_start_date"),
+                        "outcome": outcome, "n_slots": n_slots, "cash": float(cash),
+                        "cur_nav": (float(cur_nav) if cur_nav is not None else None),
+                        "target": (float(target) if target is not None else None),
+                        "state": (int(_st) if _st is not None and not pd.isna(_st) else None)})
+def _slot_audit_dump():
+    if _SLOT_AUDIT_PATH and _SLOT_AUDIT:
+        pd.DataFrame(_SLOT_AUDIT).to_csv(_SLOT_AUDIT_PATH, index=False)
+_atexit.register(_slot_audit_dump)
+
 def simulate(signals_df, prices, vni_dates, *,
              allowed_tiers, max_positions,
              hold_days=HOLD_DAYS, stop_loss=STOP_LOSS, min_hold=MIN_HOLD,
@@ -1253,6 +1274,8 @@ def simulate(signals_df, prices, vni_dates, *,
                                 and not (slot_exempt_tiers is not None
                                          and p["play_type"] in slot_exempt_tiers))
             if is_first_fill and not _slot_exempt and _n_slots >= max_positions:
+                if _SLOT_AUDIT_PATH and name in _SLOT_AUDIT_BOOKS:
+                    _slot_audit_rec(today, name, entry, "SLOT_BLOCK", _n_slots, cash, None, state_by_date)
                 if not eviction:
                     continue
                 cur_pri = TIER_PRIORITY.get(play_type, 0)
@@ -1379,8 +1402,12 @@ def simulate(signals_df, prices, vni_dates, *,
                 if cash + _margin_room < target_value * 0.99:
                     target_value = (cash + _margin_room) * 0.95
                 if target_value < 1_000_000:
+                    if _SLOT_AUDIT_PATH and name in _SLOT_AUDIT_BOOKS:
+                        _slot_audit_rec(today, name, entry, "CASH_SKIP", _n_slots, cash, cur_nav, state_by_date)
                     continue
                 entry["target_value"] = target_value
+                if _SLOT_AUDIT_PATH and name in _SLOT_AUDIT_BOOKS:
+                    _slot_audit_rec(today, name, entry, "FILL_START", _n_slots, cash, cur_nav, state_by_date, target_value)
 
             # Compute today's affordable buy
             remaining_value = entry["target_value"] - entry["filled_cost"]
