# ---- Session worktrees (2026-09-09) — see the matching block in the parent repo's
#      .gitignore. Transient per-session worktrees under agents/ were tracked as
#      GITLINKS (mode 160000, no .gitmodules); a removed worktree leaves a dangling
#      gitlink that makes `git status` fatal on recursion. That broke the nightly
#      GitHub backup for 3+ days. Work always lands on master before cleanup, so
#      nothing of value is lost by never tracking them.
agents/wt-*/

# Phase 1 kb_nightly.sh ghi events_buffer atomic: tmp + os.replace (c9edd4c6). Bị kill giữa
# chừng thì file tạm này nằm lại — không bao giờ commit.
kb/events_buffer.md.tmp
secrets/

# Work-tree dashboard: file khoá flock (ledger + merged.json)
kb/work_ledger.jsonl.lock
state/work_tree/*.lock
agents/Taylor/research/dd_price_zone_threshold_20261101/hist_2y.csv

