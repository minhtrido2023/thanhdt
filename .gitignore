# Hot runtime transport / ephemeral state — recreated by the scripts on demand,
# not part of the durable KB audit trail. (agents/ configs ARE tracked, for fleet audit.)
bus/
logs/
locks/
state/
__pycache__/

# --- Taylor experiment raw panels (housekeeping 2026-07-30, job Taylor_20260730_125303) ---
# Chính sách: thư mục agents/Taylor/exp_*/ và probe_*/ giữ SCRIPT (.py) + REPORT (.md) +
# bảng kết quả nhỏ trong git; PANEL THÔ lớn (>=512KB) và mọi .parquet/.pkl thì KHÔNG track —
# file vẫn NẰM NGUYÊN TRÊN ĐĨA (archive-first, không xoá), chỉ gỡ khỏi git tracking để
# repo không phình thêm. Panel thô KHÔNG tái tạo được (BQ time-travel tắt, ticker/
# ticker_prune rebuild mỗi ngày — coding_guidelines §8b) ⇒ tuyệt đối không xoá khỏi đĩa.
agents/Taylor/exp_*/**/*.parquet
agents/Taylor/exp_*/**/*.pkl
agents/Taylor/probe_*/**/*.parquet
agents/Taylor/probe_*/**/*.pkl
